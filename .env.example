# Copie para .env e ajuste (ou defina como variáveis de ambiente do servidor).
PORT=3000
# Pasta dos dados (banco + backups). Padrão: ./data em desenvolvimento; ~/revisao-premium-dados em produção
# (fora da pasta do programa, para atualizações não apagarem os dados). Faça backup desta pasta.
# DATA_DIR=
# DB_PATH=   (avançado: caminho completo do arquivo .db; tem prioridade sobre DATA_DIR)
# Usado só na primeira execução, para criar o Gestor KINTO inicial.
ADMIN_EMAIL=
ADMIN_NOME=Administrador
ADMIN_PASSWORD=
# Valor padrão da diária no registro de reserva.
VALOR_DIARIA_PADRAO=174.30
# SÓ ao publicar na internet com HTTPS (veja GUIA-PUBLICACAO.md). Exige ADMIN_PASSWORD de 10+ caracteres,
# redireciona http->https e usa cookie Secure. NÃO ative para testar em http://localhost.
# NODE_ENV=production
# TRUST_PROXY=1

# Escalonamento por e-mail quando ninguém da KINTO assume um cliente que aceitou.
# SMTP_URL no formato smtps://usuario:senha@smtp.empresa.com:465 (vazio = não envia).
SMTP_URL=
SMTP_FROM=revisao-premium@empresa.com
# Usado se a loja não tiver e-mail de alerta próprio.
ALERTA_EMAIL_PADRAO=
APP_URL=https://revisao.empresa.com
ESCALONA_MINUTOS=15
# Horário comercial do atendimento KINTO (0 = domingo).
ATENDIMENTO_DIAS=1,2,3,4,5,6
ATENDIMENTO_INICIO=08:00
ATENDIMENTO_FIM=18:00

# Backup automático diário (padrões: 02:00, manter 14, pasta data/backups)
# BACKUP_HORA=02:00
# BACKUP_KEEP=14
# BACKUP_DIR=
